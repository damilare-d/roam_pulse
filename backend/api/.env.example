# Copy to .env for local development. Never commit a real .env — it's
# gitignored at the repo root.

PORT=8080
DATABASE_URL=postgres://roampulse:CHANGE_ME@localhost:5432/roampulse_dev?sslmode=disable

# Optional — the Connectivity Recovery Agent (Phase 11, ADR-008) falls
# back to the deterministic diagnosis's own recommendation when this is
# unset, so leaving it blank is a supported, expected state, not an error.
ANTHROPIC_API_KEY=
